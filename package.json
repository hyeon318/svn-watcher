{
  "name": "svn-watcher",
  "productName": "SVN Watcher",
  "version": "1.1.0",
  "description": "SVN 커밋 감시 트레이 알림 에이전트",
  "author": "hyeon318",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "build:css": "tailwindcss -i src/renderer/styles/input.css -o src/renderer/styles/app.css --minify",
    "watch:css": "tailwindcss -i src/renderer/styles/input.css -o src/renderer/styles/app.css --watch",
    "icons": "node scripts/gen-icons.js",
    "start": "npm run build:css && electron .",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "electron scripts/smoke.js",
    "dist": "npm run icons && npm run build:css && electron-builder --win nsis portable"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "fast-xml-parser": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.hyeon318.svnwatcher",
    "productName": "SVN Watcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!src/renderer/styles/input.css"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SVN Watcher",
      "runAfterFinish": true,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    },
    "executableName": "SVN Watcher"
  }
}
